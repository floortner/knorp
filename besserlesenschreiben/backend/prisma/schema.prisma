// besserlesenschreiben — Prisma schema. The canonical system of record (backend SPEC §3).
// Wire format is camelCase; DB columns are snake_case (bridged via @map/@@map).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── ACCOUNT (household, keyed by parent email) ───────────────────────────────
model Account {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  // Access lifecycle (ARCHITECTURE §1b): pending → active → deactivated. A first login-code request
  // creates a `pending` account and emails NOTHING; a staff admin approves before the first code is sent.
  // The family JwtAuthGuard requires `active` per-request, so deactivate/delete take effect immediately.
  status        String   @default("pending") @map("status") // pending | active | deactivated
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profiles   Profile[]
  loginCodes LoginCode[]

  @@map("account")
}

// ── LOGIN CODES (passwordless) ───────────────────────────────────────────────
model LoginCode {
  id         String    @id @default(uuid()) @db.Uuid
  accountId  String?   @map("account_id") @db.Uuid
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  account Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("login_code")
}

// ── PROFILE (a student) ──────────────────────────────────────────────────────
model Profile {
  id           String   @id @default(uuid()) @db.Uuid
  accountId    String   @map("account_id") @db.Uuid
  name         String
  buddy        String   @default("nepo") // nepo | stella
  goalPerWeek  Int      @default(5) @map("goal_per_week")
  // accessibility / settings
  soundOn      Boolean  @default(true) @map("sound_on")
  dyslexicFont Boolean  @default(false) @map("dyslexic_font")
  fontScale    Decimal  @default(1.0) @map("font_scale") @db.Decimal(3, 2)
  // gamification & progression state
  stars        Int      @default(0)
  streakDays   Int      @default(0) @map("streak_days")
  lastActive   DateTime? @map("last_active") @db.Date
  jokerUsedWeek DateTime? @map("joker_used_week") @db.Date
  unlockedUnit Int      @default(1) @map("unlocked_unit")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  account      Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessions     Session[]
  attempts     Attempt[]
  reviewStates ReviewState[]
  homework     HomeworkUpload[]
  chatMessages ChatMessage[]
  assignments  Assignment[]

  @@index([accountId])
  @@map("profile")
}

// ── ITEM BANK (global, shared) ───────────────────────────────────────────────
model ItemBank {
  id            String   @id @default(uuid()) @db.Uuid
  seedKey       String?  @unique @map("seed_key")
  unit          Int
  exerciseType  String   @map("exercise_type")
  payload       Json
  audioUrl      String?  @map("audio_url")
  syllableAudio Json?    @map("syllable_audio")
  skillTags     String[] @map("skill_tags")
  difficulty    Int      @default(1)
  // 'seed' | 'llm' | 'staff' | 'content' — staff rows are legacy lecture-authored (§H1); content rows
  // come from the content-library import (§I2, seed_key `content:{slug}.{exId}:{hash12}` — content-
  // addressed, so an unchanged exercise keeps its row across lecture versions and a changed one gets a
  // new row while the old row keeps serving pinned assignments). Both live at unit 0 and are
  // deliberately excluded from bank rotation (createBank's generated pool filters 'llm' only).
  generatedBy   String   @default("seed") @map("generated_by")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attempts Attempt[]

  @@index([unit])
  @@map("item_bank")
}

// Lexeme (the annotated word foundation) was dropped along with the Vokaltraining content set — the
// word-list schema, training types, sequence, and lecture-generation approach are being redesigned from
// scratch. Re-add as a fresh model when the new approach's word-list shape is decided.

// ── SESSION (a generated training session) ───────────────────────────────────
model Session {
  id          String    @id @default(uuid()) @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  unit        Int?
  itemIds     String[]  @map("item_ids") @db.Uuid
  source      String // 'bank' | 'llm' | 'homework' | 'assigned'
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  starsAward  Int?      @map("stars_award")

  profile    Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  attempts   Attempt[]
  assignment Assignment?

  @@index([profileId])
  @@map("session")
}

// ── LECTURE (a teaching unit from the content library, ROADMAP §I) ───────────
// A Merksatz + ordered exercises, imported from content/lectures/<slug>.md (§I2). Items live as
// item_bank rows (generated_by='content', unit 0) referenced by id — attempt-joinable like any item.
// Content lectures are VERSIONED: an edit creates a new row (version+1) and marks the old one
// status='superseded' (never mutated) — assignments pin their version via the lecture_id FK, so
// attempts always reference exactly what the student saw. Legacy portal-authored rows (§H1) have
// slug=null + created_by set; they were superseded wholesale in the §I2 migration.
model Lecture {
  id           String    @id @default(uuid()) @db.Uuid
  slug         String? // content-library natural key (filename); null = legacy portal-authored row
  version      Int       @default(1)
  contentHash  String?   @map("content_hash") // canonical hash (src/content/hash.ts) — the import's same-or-new test
  sourcePath   String?   @map("source_path") // e.g. content/lectures/dehnungs-h.md
  createdBy    String?   @map("created_by") @db.Uuid // null = content-library import
  title        String
  intro        String // the Merksatz shown as the lesson's teaching intro card
  itemIds      String[]  @map("item_ids") @db.Uuid // ordered
  skillTags    String[]  @map("skill_tags") // union of the items' tags, computed on import
  status       String    @default("draft") // draft | published | superseded
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  author      Trainer?     @relation("LectureAuthor", fields: [createdBy], references: [id])
  assignments Assignment[]

  @@unique([slug, version]) // legacy rows (slug null) are exempt — Postgres treats NULLs as distinct
  @@index([slug, status])
  @@index([status])
  @@map("lecture")
}

// ── ASSIGNMENT (lecture × student, ROADMAP §H1) ──────────────────────────────
// An OFFER on /lernen, never a push (§H invariants). Status is derived, not stored:
// open (no session) → started (session, not completed) → completed.
model Assignment {
  id          String    @id @default(uuid()) @db.Uuid
  lectureId   String    @map("lecture_id") @db.Uuid
  profileId   String    @map("profile_id") @db.Uuid
  assignedBy  String    @map("assigned_by") @db.Uuid
  assignedAt  DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(6)
  // Latest play-through; a restart overwrites. SetNull because profile reset hard-deletes sessions —
  // the assignment then reads as open again (completed ones keep completedAt as the historical record).
  sessionId   String?   @unique @map("session_id") @db.Uuid
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  lecture  Lecture  @relation(fields: [lectureId], references: [id]) // withdraw/delete rules live in the service
  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  assigner Trainer  @relation("AssignmentAssigner", fields: [assignedBy], references: [id])
  session  Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([lectureId, profileId]) // idempotent assign (createMany skipDuplicates)
  @@index([profileId, completedAt]) // the family "open assignments" read
  @@map("assignment")
}

// ── ATTEMPT (THE telemetry table — one row per answered item) ────────────────
model Attempt {
  id           String   @id @default(uuid()) @db.Uuid
  profileId    String   @map("profile_id") @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  itemId       String?  @map("item_id") @db.Uuid
  exerciseType String   @map("exercise_type")
  prompt       String
  expected     String
  given        String
  isCorrect    Boolean  @map("is_correct")
  timeMs       Int      @map("time_ms")
  attemptNo    Int      @default(1) @map("attempt_no")
  skillTags    String[] @map("skill_tags")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  session Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  item    ItemBank? @relation(fields: [itemId], references: [id])

  // NOTE (ARCHITECTURE §4): idempotency dedupe on (session_id, item_id, attempt_no) needs a
  // functional unique index with COALESCE(item_id, '0…0') because item_id is nullable and NULLs
  // are distinct in Postgres. Added as raw SQL in the migration, not expressible here.
  @@index([profileId])
  @@index([sessionId])
  @@map("attempt")
}

// ── FSRS scheduling state (one row per profile × skill_tag) ──────────────────
model ReviewState {
  id            String    @id @default(uuid()) @db.Uuid
  profileId     String    @map("profile_id") @db.Uuid
  skillTag      String    @map("skill_tag")
  stability     Decimal?
  difficulty    Decimal?
  state         Int       @default(0) // 0=new 1=learning 2=review 3=relearning
  reps          Int       @default(0)
  lapses        Int       @default(0)
  learningSteps Int       @default(0) @map("learning_steps") // ts-fsrs step index; persisted so mid-learning isn't reset
  elapsedDays   Int       @default(0) @map("elapsed_days")
  scheduledDays Int       @default(0) @map("scheduled_days")
  due           DateTime? @db.Timestamptz(6)
  lastReview    DateTime? @map("last_review") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, skillTag])
  @@index([profileId, due])
  @@map("review_state")
}

// ── HOMEWORK uploads + analysis ──────────────────────────────────────────────
model HomeworkUpload {
  id        String @id @default(uuid()) @db.Uuid
  profileId String @map("profile_id") @db.Uuid
  imageKey  String @map("image_key")
  // pending_analysis | pending_review | reviewed | rejected
  status    String @default("pending_analysis")

  llmAnalysis      Json?     @map("llm_analysis") // DRAFT vision output — NEVER applied on its own
  reviewedAnalysis Json?     @map("reviewed_analysis") // AUTHORITATIVE; only this mutates the learning profile
  trainerId       String?   @map("trainer_id") @db.Uuid // who actioned it (null until reviewed)
  reviewDecision   String?   @map("review_decision") // approved|corrected|rejected
  reviewedAt       DateTime? @map("reviewed_at") @db.Timestamptz(6)
  appliedAt        DateTime? @map("applied_at") @db.Timestamptz(6) // when reviewedAnalysis hit attempt/review_state
  claimedBy        String?   @map("claimed_by") @db.Uuid // soft-lock so two trainers don't grab the same item
  claimedUntil     DateTime? @map("claimed_until") @db.Timestamptz(6) // claim lease expiry (auto-released)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  profile  Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  trainer Trainer?        @relation("TrainerActioned", fields: [trainerId], references: [id])
  claimant Trainer?        @relation("TrainerClaimed", fields: [claimedBy], references: [id])
  reviews  HomeworkReview[]

  @@index([profileId])
  @@index([status]) // queue scan for pending_review
  @@map("homework_upload")
}

// ── STAFF realm: internal literacy professionals (ARCHITECTURE §1a) ──────────
// DISJOINT identity from Account/Profile — a staff credential is never valid in the family realm.
model Trainer {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique // staff login (never a family email)
  name      String
  role      String   @default("trainer") // trainer|admin
  status    String   @default("active") // active|revoked
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actioned HomeworkUpload[] @relation("TrainerActioned")
  claimed  HomeworkUpload[] @relation("TrainerClaimed")
  reviews  HomeworkReview[]
  lectures Lecture[]        @relation("LectureAuthor")
  assigned Assignment[]     @relation("AssignmentAssigner")

  @@map("trainer")
}

// ── STAFF login codes (passwordless, disjoint from family login_code) ─────────
// Separate table so a staff code can never be consumed by a family verify and vice-versa, even if an
// email somehow appears in both realms. Staff are admin-provisioned (no self-signup) — request-code only
// issues a code when an active trainer owns the email, but always returns ok (no enumeration).
model StaffLoginCode {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@map("staff_login_code")
}

// ── HOMEWORK review audit (append-only) ──────────────────────────────────────
// Retains the LLM draft + trainer verdict so vision quality is measurable ("compare vs LLM", SPEC §10).
model HomeworkReview {
  id               String   @id @default(uuid()) @db.Uuid
  uploadId         String   @map("upload_id") @db.Uuid
  trainerId       String   @map("trainer_id") @db.Uuid
  decision         String // approved|corrected|rejected
  llmAnalysis      Json     @map("llm_analysis") // snapshot of the draft shown to the trainer
  reviewedAnalysis Json?    @map("reviewed_analysis") // the verdict (null when rejected)
  agreedWithLlm    Boolean  @map("agreed_with_llm") // false ⇒ trainer changed something (LLM-quality signal)
  notes            String? // optional trainer comment — STUDENT-VISIBLE (chat status bubble); never student-identifying
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  upload   HomeworkUpload @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  trainer Trainer       @relation(fields: [trainerId], references: [id])

  @@index([uploadId])
  @@index([trainerId])
  @@map("homework_review")
}

// ── CHAT (trainer conversation thread, per student profile) ──────────────────
model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  role      String // 'student' | 'trainer' (read path also tolerates legacy 'child' rows)
  text      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("chat_message")
}

// Billing (entitlement / credits_ledger / processed_webhook) is DEFERRED and its tables were dropped
// (ARCHITECTURE §9). Re-add them by migration if metering is ever introduced.
