{
  "name": "besserlesenschreiben-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Adaptive German literacy tutor for students (ages 8-14) — backend API",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "prisma db seed",
    "seed:e2e": "tsx scripts/seed-e2e.ts",
    "content:validate": "tsx scripts/content-validate.ts",
    "content:import": "tsx scripts/content-import.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "llm:smoke": "tsx scripts/llm-smoke.ts",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@aws-sdk/client-s3": "^3.1079.0",
    "@aws-sdk/client-sesv2": "^3.1080.0",
    "@aws-sdk/s3-request-presigner": "^3.1079.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.4",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "^7",
    "@prisma/client": "^7",
    "argon2": "^0.43",
    "dotenv": "^17.4.2",
    "gray-matter": "^4.0.3",
    "nestjs-pino": "^5.2.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "sharp": "^0.35.4",
    "ts-fsrs": "^5.4.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11",
    "@nestjs/schematics": "^11",
    "@nestjs/testing": "^12.1.0",
    "@swc/core": "^1",
    "@types/node": "^24",
    "eslint": "^10.11.0",
    "pino-pretty": "^13",
    "prisma": "^7",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "unplugin-swc": "^1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "argon2@0.43.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "@swc/core@1.16.2": true,
    "@scarf/scarf@1.4.0": true,
    "fsevents@2.3.3": true
  }
}
